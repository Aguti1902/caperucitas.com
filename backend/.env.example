# Base de datos (Supabase)
DATABASE_URL="postgresql://postgres:PASSWORD@db.XXXX.supabase.co:6543/postgres?pgbouncer=true"
# Recomendado en Railway: puerto 6543 (Transaction pooler) en lugar de 5432 (Session mode, máx. 15 conexiones)

# JWT (genera una clave larga y aleatoria)
JWT_SECRET="tu-clave-secreta-muy-larga-aqui"
JWT_ACCESS_SECRET="tu-clave-secreta-muy-larga-aqui"
JWT_REFRESH_SECRET="tu-clave-secreta-refresh-aqui"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Servidor
PORT=4000
NODE_ENV="production"

# Frontend URL (tu dominio de Vercel o caperucitas.com)
FRONTEND_URL="https://caperucitas.com,https://www.caperucitas.com"

# Admin
ADMIN_PASSWORD="cambia-esta-contraseña"

# WhatsApp integrado (usa Supabase — no requiere Evolution API)
WHATSAPP_PROVIDER=builtin
WHATSAPP_INSTANCE_NAME=caperucitas
# Número emisor por defecto (internacional sin +). Ej: 34612345678
WHATSAPP_SENDER_PHONE=

# Opcional: Evolution API externa (solo si WHATSAPP_PROVIDER=evolution)
# EVOLUTION_API_URL="https://tu-servidor-evolution.com"
# EVOLUTION_API_KEY="tu-api-key"
# EVOLUTION_INSTANCE_NAME="tu-instancia"

# Google Analytics 4 (panel admin → Analíticas)
# ID numérico de la propiedad GA4 (Admin → Detalles de la propiedad)
GA4_PROPERTY_ID=""
# JSON de la cuenta de servicio (Google Cloud → clave JSON, en una línea)
GA4_SERVICE_ACCOUNT_JSON=""
# ID de medición G-XXXXXXXX (opcional, solo referencia)
GA4_MEASUREMENT_ID=""

# Cloudinary (para subida de fotos - opcional por ahora)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
