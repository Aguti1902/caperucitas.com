# Copia a Railway como variables de entorno del servicio Evolution API
AUTHENTICATION_API_KEY=genera-con-openssl-rand-hex-32
SERVER_URL=https://TU-SERVICIO-evolution.up.railway.app
SERVER_PORT=8080

# Sin base de datos externa (config mínima)
DATABASE_ENABLED=false
DATABASE_PROVIDER=
DATABASE_CONNECTION_URI=

CACHE_REDIS_ENABLED=false
CACHE_LOCAL_ENABLED=true

# Logs
LOG_LEVEL=ERROR
LOG_BAILEYS=error
